    "@tabler/icons-react": "^2.44.0",
    "concurrently": "^8.2.2",
    "next": "^14.2.35",
    "nodemailer": "^6.9.8",
    "react": "^18",
    "react-dom": "^18",
    "sass": "^1.66.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "supabase": "^2.122.0",
    "typescript": "^5"
  }
